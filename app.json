{
  "expo": {
    "name": "logiclab-mobile-testing",
    "slug": "logiclab-mobile-testing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "logiclabmobiletesting",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.laurensiusdanir.logiclabmobiletesting",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to scan QR codes and capture images.",
        "NSPhotoLibraryUsageDescription": "This app requires photo library access to select and upload images.",
        "NSLocationWhenInUseUsageDescription": "This app requires location access to provide location-based features."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.laurensiusdanir.logiclabmobiletesting"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.424039843806-71gaim4tsm3g7pf93jmjahsb2rjai2q9"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0bd85d19-6f26-4045-90f7-3fc68f4dc6eb"
      }
    },
    "owner": "logiclab-mobile"
  }
}
